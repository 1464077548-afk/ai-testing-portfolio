# 复制为 .env 后按需修改。.env 已在 .gitignore 中，不会进版本库。
# 优先级：命令行参数 > 环境变量 > .env > 默认值

# ---- 基础 ----
# local | staging | prod。prod 会自动跳过 destructive 用例
GITLAB_ENV=local
GITLAB_BASE_URL=http://localhost:8929

# Personal Access Token，需要 api + read_repository + write_repository
# 自建实例签发：python tools/doctor.py --issue-token
GITLAB_TOKEN=

# ---- 第二个身份（权限/越权断言用，可选）----
# 普通用户或只读 Token。没有它，越权类用例会 skip 而不是假装通过 ——
# 用管理员去访问管理员端点永远返回 200，断言恒真，等于没测。
# 想真验证「普通用户拿 403」就必须配这个。
GITLAB_MEMBER_TOKEN=

GITLAB_ADMIN_USER=root
GITLAB_ROOT_PASSWORD=
GITLAB_SSH_PORT=2222

# ---- 超时 ----
GITLAB_TIMEOUT=20

# ---- 性能门禁 ----
PERF_CONCURRENCY=8
PERF_SAMPLES=60
PERF_P95_MS=1500
# 错误率上限。设得比 0 高一点：公网实例偶发 429/5xx 不代表被测系统有问题
PERF_ERROR_RATE=0.02

# ---- 测试数据 ----
# 所有自动创建的项目/issue 都带这个前缀，便于批量识别和清理
RESOURCE_PREFIX=qa-auto

# ---- 安全测试（tools/run.py --suite security）----
# 信任边界：除本机地址与 GITLAB_BASE_URL 自身之外，其它目标必须在这里显式授权。
# 逗号分隔，支持 * 通配，例如：gitlab.internal.example.com,10.20.*.*
# 安全用例只对自己拥有的实例执行；不在白名单时 skip（不会照跑）。
SECURITY_ALLOWED_HOSTS=

# ---- 产物清理（tools/cleanup.py / tools/schedule_cleanup.ps1）----
# 保留天数：只删 N 天前的截图 / trace / 日志 / 旧结果
CLEANUP_RETENTION_DAYS=7
# 单目录体积上限（MB），超过时从最旧开始删；0 = 不限制
CLEANUP_MAX_MB=1024
# 每个目录至少保留最新 K 个文件，防止清空
CLEANUP_KEEP_LATEST=3
# 清理范围：artifacts,results,report,logs,cache
CLEANUP_TARGETS=artifacts,results,report,logs,cache
